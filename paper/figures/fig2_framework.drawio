<mxfile>
  <diagram name="GP+BO+AIA Framework">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="title" value="图2 GP+BO+AIA闭环融合框架&#xa;Fig.2 GP+BO+AIA Closed-loop Fusion Framework" style="text;html=1;align=center;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="400" height="40" as="geometry"/>
        </mxCell>
        <!-- Layer 1: GP -->
        <mxCell id="gp_box" value="" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=0" vertex="1" parent="1">
