        <mxCell id="arrow1" value="GP预测+不确定性" style="endArrow=block;html=1;strokeColor=#2196F3;strokeWidth=2;fontSize=9;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="160" as="sourcePoint"/>
            <mxPoint x="400" y="160" as="targetPoint"/>
