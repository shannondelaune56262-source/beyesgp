        </mxCell>
        <mxCell id="bo_title" value="第2层：BO智能勘探&#xa;Layer 2: BO Intelligent Exploration" style="text;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="410" y="65" width="260" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="bo_ei" value="EI采集函数&#xa;$lpha(x)$" style="rounded=1;fillColor=#c3dbc3;strokeColor=#82b366;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="bo_search" value="定向搜索&#xa;薄弱点邻域&#xa;{new}$候选" style="rounded=1;fillColor=#c3dbc3;strokeColor=#82b366;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="80" height="50" as="geometry"/>
        </mxCell>
