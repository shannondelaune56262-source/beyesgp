        </mxCell>
        <!-- Layer 3: AIA -->
        <mxCell id="aia_box" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="280" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="aia_title" value="第3层：AIA安全边界&#xa;Layer 3: AIA Security Boundary" style="text;html=1;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
