        <mxCell id="output" value="输出：分场景AIA边界&#xa;+ 传输容量限额" style="shape=parallelogram;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="750" y="290" width="180" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
