        </mxCell>
        <mxCell id="aia_prune" value="冗余面剪枝&#xa;=\{x|Ax\leq b\}$" style="rounded=1;fillColor=#e6d8c3;strokeColor=#d6b656;fontSize=9" vertex="1" parent="1">
