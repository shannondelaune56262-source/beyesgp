        </mxCell>
        <mxCell id="gp_title" value="第1层：多输出GP数字孪生&#xa;Layer 1: Multi-output GP Digital Twin" style="text;html=1;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="60" y="65" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="gp_train" value="GP训练&#xa;Matérn 5/2核&#xa;5-fold CV" style="rounded=1;fillColor=#bbdaf7;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gp_pred" value="GP预测&#xa;$\hat{S}(x)$+$\sigma(x)$&#xa;不确定性量化" style="rounded=1;fillColor=#bbdaf7;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gp_validate" value="GP验证&#xa;安全率检查" style="rounded=1;fillColor=#bbdaf7;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="260" y="100" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gp_outputs" value="输出：{angle}$, {freq}$, {voltage}$, $" style="text;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="240" height="20" as="geometry"/>
        </mxCell>
        <!-- Layer 2: BO -->
        <mxCell id="bo_box" value="" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1">
